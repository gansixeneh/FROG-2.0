@prefix :      <#> .
@prefix fuseki: <http://jena.apache.org/fuseki#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tdb2:  <http://jena.apache.org/2016/tdb#> .

:service_visualization_logs  a          fuseki:Service ;
    rdfs:label                         "Visualization Logs Dataset" ;
    fuseki:dataset                     :dataset_visualization_logs ;
    fuseki:name                        "visualization-logs" ;
    fuseki:serviceQuery                "query" , "sparql" ;
    fuseki:serviceReadGraphStore       "get" ;
    fuseki:serviceReadWriteGraphStore  "data" ;
    fuseki:serviceUpdate               "update" ;
    fuseki:serviceUpload               "upload" .
:dataset_visualization_logs  a        tdb2:DatasetTDB2 ;
    tdb2:location      "/Users/muflihmaxi/fuseki-data/visualization-logs" ;
.

:service_curi  a                   fuseki:Service ;
    rdfs:label                        "curi Dataset" ;
    fuseki:dataset                    :dataset_curi ;
    fuseki:name                       "curi" ;
    fuseki:serviceQuery               "query" , "sparql" ;
    fuseki:serviceReadGraphStore      "get" ;
    fuseki:serviceReadWriteGraphStore "data" ;
    fuseki:serviceUpdate              "update" ;
    fuseki:serviceUpload              "upload" .
:dataset_curi  a        tdb2:DatasetTDB2 ;
    tdb2:location      "/Users/muflihmaxi/fuseki-data/curi" ;
.

:service_gesis  a                   fuseki:Service ;
