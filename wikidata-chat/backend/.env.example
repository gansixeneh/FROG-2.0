# Environment variables for LLM providers

# Required for Gemini provider
GEMINI_API_KEY=your_gemini_api_key_here

# Required for Kaggle provider (optional - only needed if using Kaggle models)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Apache Jena Fuseki server URL (default: http://localhost:3030)
APACHE_JENA_URL=http://localhost:3030